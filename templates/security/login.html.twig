{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto bg-white rounded-xl shadow p-8">
        <h1 class="text-2xl font-bold mb-6 text-center">Connexion</h1>

        {% if error %}
            <div class="mb-4 rounded bg-red-100 text-red-800 px-4 py-2">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="mb-4 rounded bg-blue-100 text-blue-800 px-4 py-2">
                Vous êtes connecté en tant que {{ app.user.userIdentifier }}.
                <a href="{{ path('app_logout') }}" class="underline">Se déconnecter</a>
            </div>
        {% endif %}

        <form method="post" class="space-y-4">
            <div>
                <label for="username" class="block text-sm font-medium mb-1">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username"
                       class="w-full border rounded-lg px-3 py-2" autocomplete="email" required autofocus>
            </div>

            <div>
                <label for="password" class="block text-sm font-medium mb-1">Mot de passe</label>
                <input type="password" name="_password" id="password"
                       class="w-full border rounded-lg px-3 py-2" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                Se souvenir de moi
            </label>

            <button type="submit" class="w-full bg-indigo-600 text-white font-semibold py-2 rounded-full hover:bg-indigo-700">
                Se connecter
            </button>
        </form>

        <p class="text-center text-sm mt-6">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="text-indigo-600 hover:underline">Créer un compte</a>
        </p>
    </div>
{% endblock %}