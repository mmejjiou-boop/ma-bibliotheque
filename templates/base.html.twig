<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Ma Bibliothèque{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📚</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    {% set theme = app.user ? app.user.theme : 'clair' %}
    <body class="bg-gray-50 text-gray-800 min-h-screen {{ theme == 'sombre' ? 'dark' }}">
        {% if theme == 'auto' %}
            <script>
                if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    document.body.classList.add('dark');
                }
            </script>
        {% endif %}
        <nav class="bg-indigo-700 text-white shadow" data-controller="menu">
            <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
                <a href="{{ path('app_home') }}" class="text-xl font-bold">Ma Bibliothèque</a>

                <button type="button" class="md:hidden p-2 rounded hover:bg-indigo-600"
                        data-action="menu#basculer" aria-controls="menu-principal" aria-expanded="false" aria-label="Ouvrir le menu">
                    <svg data-menu-target="ouvrir" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                    <svg data-menu-target="fermer" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/>
                    </svg>
                </button>

                <div class="hidden md:flex items-center gap-4 text-sm">
                    {{ include('_menu_liens.html.twig') }}
                </div>
            </div>

            <div id="menu-principal" data-menu-target="panneau" class="hidden md:hidden border-t border-indigo-600">
                <div class="px-4 py-4 flex flex-col items-start gap-4 text-base">
                    {{ include('_menu_liens.html.twig') }}
                </div>
            </div>
        </nav>

        <main class="max-w-6xl mx-auto px-4 py-8">
            {% for message in app.flashes('success') %}
                <div class="mb-4 rounded bg-green-100 text-green-800 px-4 py-2">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="mb-4 rounded bg-red-100 text-red-800 px-4 py-2">{{ message }}</div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="border-t mt-12">
            <div class="max-w-6xl mx-auto px-4 py-6 flex flex-wrap justify-between gap-2 text-sm text-gray-500">
                <p>&copy; {{ 'now'|date('Y') }} Ma Bibliothèque</p>
                <a href="{{ path('app_mentions_legales') }}" class="hover:underline">Mentions légales</a>
            </div>
        </footer>
    </body>
</html>