<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Ma Bibliothèque{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📚</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-gray-50 text-gray-800 min-h-screen">
        <nav class="bg-indigo-700 text-white shadow">
            <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
                <a href="{{ path('app_home') }}" class="text-xl font-bold">Ma Bibliothèque</a>

                <div class="flex items-center gap-4 text-sm">
                    <a href="{{ path('app_home') }}" class="hover:underline">Catalogue</a>

                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin') }}" class="hover:underline">Gestion des médias</a>
                    {% endif %}

                    {% if app.user %}
                        <a href="{{ path('app_mes_emprunts') }}" class="hover:underline">Mes emprunts</a>
                        <span class="text-indigo-200">{{ app.user.prenom }}</span>
                        <a href="{{ path('app_logout') }}" class="bg-white text-indigo-700 px-3 py-1 rounded hover:bg-indigo-100">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="hover:underline">Connexion</a>
                        <a href="{{ path('app_register') }}" class="bg-white text-indigo-700 px-3 py-1 rounded hover:bg-indigo-100">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </nav>

        <main class="max-w-6xl mx-auto px-4 py-8">
            {% for message in app.flashes('success') %}
                <div class="mb-4 rounded bg-green-100 text-green-800 px-4 py-2">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="mb-4 rounded bg-red-100 text-red-800 px-4 py-2">{{ message }}</div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>