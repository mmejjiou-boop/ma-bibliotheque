{% extends 'base.html.twig' %}

{% block title %}Mes emprunts{% endblock %}

{% block body %}
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <h1 class="text-3xl font-bold">Mes emprunts</h1>
        <span class="bg-white shadow rounded-full px-4 py-2 text-sm">
            <strong>{{ nbEnCours }}</strong> / {{ max }} emprunts en cours
        </span>
    </div>

    <div class="bg-white rounded-xl shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-100 text-left">
                <tr>
                    <th class="px-4 py-3">Média</th>
                    <th class="px-4 py-3">Emprunté le</th>
                    <th class="px-4 py-3">Retour prévu</th>
                    <th class="px-4 py-3">Statut</th>
                    <th class="px-4 py-3">Action</th>
                </tr>
            </thead>
            <tbody>
            {% for emprunt in emprunts %}
                <tr class="border-t">
                    <td class="px-4 py-2">
                        <a href="{{ path('app_catalogue_show', {id: emprunt.media.id}) }}" class="font-semibold text-indigo-600 hover:underline">{{ emprunt.media.titre }}</a>
                        <span class="text-gray-500">({{ emprunt.media.type }})</span>
                    </td>
                    <td class="px-4 py-2">{{ emprunt.dateEmprunt|date('d/m/Y') }}</td>
                    <td class="px-4 py-2">{{ emprunt.dateRetourPrevue|date('d/m/Y') }}</td>
                    <td class="px-4 py-2">
                        {% if emprunt.enRetard %}
                            <span class="bg-red-100 text-red-800 px-2 py-1 rounded">En retard</span>
                        {% elseif emprunt.enCours %}
                            <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded">En cours</span>
                        {% else %}
                            <span class="bg-green-100 text-green-800 px-2 py-1 rounded">Rendu le {{ emprunt.dateRetour|date('d/m/Y') }}</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-2">
                        {% if emprunt.enCours %}
                            <form method="post" action="{{ path('app_rendre', {id: emprunt.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('rendre' ~ emprunt.id) }}">
                                <button class="bg-indigo-600 text-white px-3 py-1 rounded-full hover:bg-indigo-700">Rendre</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="px-4 py-6 text-center text-gray-500">
                        Aucun emprunt. <a href="{{ path('app_home') }}" class="text-indigo-600 hover:underline">Parcourir le catalogue</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}