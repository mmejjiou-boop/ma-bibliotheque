{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-4">
            {{ include('_avatar.html.twig', {user: app.user, taille: 'w-20 h-20 text-2xl'}) }}
            <div>
                <h1 class="text-3xl font-bold">{{ app.user.prenom }} {{ app.user.nom }}</h1>
                <p class="text-gray-500">Membre depuis le {{ app.user.createdAt|date('d/m/Y') }}</p>
            </div>
        </div>
        <a href="{{ path('app_mes_emprunts') }}" class="bg-indigo-600 text-white font-semibold px-5 py-2 rounded-full shadow hover:bg-indigo-700">Mes emprunts</a>
    </div>

    <div class="grid grid-cols-3 gap-4 mb-8">
        <div class="bg-white rounded-xl shadow p-5">
            <p class="text-sm text-gray-500">Emprunts en cours</p>
            <p class="text-3xl font-bold text-indigo-600">{{ nbEnCours }}</p>
        </div>
        <div class="bg-white rounded-xl shadow p-5">
            <p class="text-sm text-gray-500">En retard</p>
            <p class="text-3xl font-bold {{ nbEnRetard > 0 ? 'text-red-600' : 'text-green-600' }}">{{ nbEnRetard }}</p>
        </div>
        <div class="bg-white rounded-xl shadow p-5">
            <p class="text-sm text-gray-500">Emprunts au total</p>
            <p class="text-3xl font-bold">{{ nbTotal }}</p>
        </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white rounded-xl shadow p-6">
            <h2 class="text-lg font-semibold mb-4">Mes informations</h2>
            {{ form_start(profilForm) }}
                {{ form_widget(profilForm) }}
                <button class="bg-indigo-600 text-white font-semibold px-5 py-2 rounded-full hover:bg-indigo-700">Enregistrer</button>
            {{ form_end(profilForm) }}
        </div>

        <div class="flex flex-col gap-8">
            <div class="bg-white rounded-xl shadow p-6">
                <h2 class="text-lg font-semibold mb-4">Photo et apparence</h2>
                {{ form_start(preferencesForm) }}
                    {{ form_row(preferencesForm.photoFile) }}
                    {{ form_row(preferencesForm.theme) }}
                    <button class="bg-indigo-600 text-white font-semibold px-5 py-2 rounded-full hover:bg-indigo-700">Enregistrer</button>
                {{ form_end(preferencesForm) }}

                {% if app.user.photo %}
                    <form method="post" action="{{ path('app_profil_photo_supprimer') }}" class="mt-3" onsubmit="return confirm('Supprimer votre photo ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer_photo') }}">
                        <button class="text-sm text-red-600 hover:underline">Supprimer ma photo</button>
                    </form>
                {% endif %}
            </div>

            <div class="bg-white rounded-xl shadow p-6">
                <h2 class="text-lg font-semibold mb-4">Changer mon mot de passe</h2>
                {{ form_start(motDePasseForm) }}
                    {{ form_widget(motDePasseForm) }}
                    <button class="bg-indigo-600 text-white font-semibold px-5 py-2 rounded-full hover:bg-indigo-700">Changer le mot de passe</button>
                {{ form_end(motDePasseForm) }}
            </div>
        </div>
    </div>
{% endblock %}
