{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
    {{ include('admin/_nav.html.twig') }}

    <div class="bg-white rounded-xl shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-100 text-left">
                <tr>
                    <th class="px-4 py-3">Nom</th>
                    <th class="px-4 py-3">Email</th>
                    <th class="px-4 py-3">Ville</th>
                    <th class="px-4 py-3">Inscrit le</th>
                    <th class="px-4 py-3">Rôle</th>
                    <th class="px-4 py-3">Action</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr class="border-t hover:bg-gray-50">
                    <td class="px-4 py-2 font-semibold">{{ user.prenom }} {{ user.nom }}</td>
                    <td class="px-4 py-2">{{ user.email }}</td>
                    <td class="px-4 py-2">{{ user.ville }}</td>
                    <td class="px-4 py-2">{{ user.createdAt|date('d/m/Y') }}</td>
                    <td class="px-4 py-2">
                        {% if 'ROLE_SUPER_ADMIN' in user.roles %}
                            <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded">Super admin</span>
                        {% elseif 'ROLE_ADMIN' in user.roles %}
                            <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded">Admin</span>
                        {% else %}
                            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded">Utilisateur</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-2">
                        {% if 'ROLE_SUPER_ADMIN' not in user.roles %}
                            <form method="post" action="{{ path('app_admin_users_role', {'id': user.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('role' ~ user.id) }}">
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <button class="bg-red-600 text-white px-3 py-1 rounded-full hover:bg-red-700">Retirer admin</button>
                                {% else %}
                                    <button class="bg-indigo-600 text-white px-3 py-1 rounded-full hover:bg-indigo-700">Passer admin</button>
                                {% endif %}
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}