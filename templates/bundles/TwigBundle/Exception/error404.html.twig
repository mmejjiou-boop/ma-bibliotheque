{% extends 'base.html.twig' %}

{% block title %}Page introuvable{% endblock %}

{% block body %}
    <div class="text-center py-16">
        <p class="text-7xl mb-4">📖</p>
        <p class="text-6xl font-bold text-indigo-600 mb-2">404</p>
        <h1 class="text-2xl font-bold mb-3">Cette page est introuvable</h1>
