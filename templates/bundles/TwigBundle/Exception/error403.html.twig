{% extends 'base.html.twig' %}

{% block title %}Accès refusé{% endblock %}

{% block body %}
    <div class="text-center py-16">
        <p class="text-7xl mb-4">🔒</p>
        <p class="text-6xl font-bold text-indigo-600 mb-2">403</p>
        <h1 class="text-2xl font-bold mb-3">Accès refusé</h1>
        <p class="text-gray-500 mb-8">Vous n'avez pas les droits nécessaires pour accéder à cette page.</p>

        <div class="flex flex-wrap justify-center gap-3">
            <a href="{{ path('app_home') }}" class="bg-indigo-600 text-white px-6 py-3 rounded-full hover:bg-indigo-700">Retour à l'accueil</a>
            {% if not app.user %}
                <a href="{{ path('app_login') }}" class="bg-white border px-6 py-3 rounded-full hover:bg-gray-100">Se connecter</a>
            {% endif %}
        </div>
    </div>
{% endblock %}
