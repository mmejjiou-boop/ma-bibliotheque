{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }}{% endblock %}

{% block body %}
    <div class="text-center py-16">
        <p class="text-7xl mb-4">⚠️</p>
        <p class="text-6xl font-bold text-indigo-600 mb-2">{{ status_code }}</p>
        <h1 class="text-2xl font-bold mb-3">Une erreur est survenue</h1>
        <p class="text-gray-500 mb-8">{{ status_text }}</p>

        <a href="{{ path('app_home') }}" class="bg-indigo-600 text-white px-6 py-3 rounded-full hover:bg-indigo-700">Retour à l'accueil</a>
    </div>
{% endblock %}
